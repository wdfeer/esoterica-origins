{
  "name": "Crimson Energy",
  "description": "Increase the combo counter on every melee hit dealing 4 or more damage, up to 25 combo. Gain +1 melee damage and +4 armor for each 5 combo. Combo resets after 10 seconds without hitting anything.",
  "type": "origins:multiple",
  "counter": {
    "type": "origins:resource",
    "min": 0,
    "max": 25,
    "hud_render": {
      "should_render": true,
      "sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_02.png",
      "bar_index": 1
    }
  },
  "increment": {
    "type": "origins:self_action_on_hit",
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:change_resource",
          "resource": "*:*_counter",
          "change": 1
        },
        {
          "type": "origins:trigger_cooldown",
          "power": "*:*_wear_off_timer"
        }
      ]
    },
    "damage_condition": {
      "type": "origins:amount",
      "comparison": ">=",
      "compare_to": 4.0
    }
  },
  "wear_off_timer": {
    "type": "origins:cooldown",
    "cooldown": 200
  },
  "wear_off": {
    "type": "origins:action_over_time",
    "interval": 5,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_counter",
      "change": -999
    },
    "condition": {
      "type": "origins:resource",
      "resource": "*:*_wear_off_timer",
      "comparison": "==",
      "compare_to": 0
    }
  },
  "buff10": {
    "type": "origins:conditioned_attribute",
    "modifiers": [
      {
        "attribute": "minecraft:generic.attack_damage",
        "operation": "addition",
        "value": 1
      },
      {
        "attribute": "minecraft:generic.armor",
        "operation": "addition",
        "value": 4
      }
    ],
    "condition": {
      "type": "origins:resource",
      "resource": "*:*_counter",
      "comparison": ">=",
      "compare_to": 5
    },
    "tick_rate": 2
  },

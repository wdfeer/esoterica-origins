{
  "name": "Life Support",
  "description": "Every 4 seconds, creatures within 4 blocks, including yourself, regain 1 health. This excludes creatures affected by Wither.",
  "type": "origins:multiple",
  "cooldown": {
    "type": "origins:cooldown",
    "cooldown": 80,
    "hud_render": {
      "should_render": true,
      "sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_02.png",
      "bar_index": 9
    }
  },
  "periodic_heal": {
    "type": "origins:action_over_time",
    "interval": 2,
    "condition": {
      "type": "origins:resource",
      "resource": "*:*_cooldown",
      "comparison": "==",
      "compare_to": 0
    },
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:area_of_effect",
          "radius": 4,
          "include_target": true,
          "bientity_action": {
            "type": "origins:target_action",
            "action": {
              "type": "origins:heal",
              "amount": 1
            }
          }
        },
        {
          "type": "origins:trigger_cooldown",
          "power": "*:*_cooldown"
        }
      ]
    }
  }
}

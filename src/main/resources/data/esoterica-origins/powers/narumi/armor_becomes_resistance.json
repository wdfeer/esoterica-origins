{
  "name": "Granite Reinforcement",
  "description": "You permanently have 4 armor. Equipping armor items destroys them, providing you with Resistance for 30 seconds.",
  "type": "origins:multiple",
  "armor_buff": {
    "type": "origins:attribute",
    "modifier": {
      "attribute": "minecraft:generic.armor",
      "operation": "addition",
      "value": 4
    }
  },
  "consume_armor": {
    "type": "origins:action_over_time",
    "interval": 10,
    "condition": {
      "type": "origins:or",
      "conditions": [
        {
          "type": "origins:equipped_item",
          "equipment_slot": "head",
          "item_condition": {
            "type": "origins:armor_value",
            "comparison": ">",
            "compare_to": 0
          }
        },
        {
          "type": "origins:equipped_item",
          "equipment_slot": "chest",
          "item_condition": {
            "type": "origins:armor_value",
            "comparison": ">",
            "compare_to": 0
          }
        },
        {
          "type": "origins:equipped_item",
          "equipment_slot": "legs",
          "item_condition": {
            "type": "origins:armor_value",
            "comparison": ">",
            "compare_to": 0
          }
        },
        {
          "type": "origins:equipped_item",
          "equipment_slot": "feet",
          "item_condition": {
            "type": "origins:armor_value",
            "comparison": ">",
            "compare_to": 0
          }
        }
      ]
    },
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:equipped_item_action",
          "equipment_slot": "head",
          "action": {
            "type": "origins:if_else",
            "condition": {
              "type": "origins:armor_value",
              "comparison": ">",
              "compare_to": 0
            },
            "if_action": {
              "type": "origins:consume"
            }
          }
        },
        {
          "type": "origins:equipped_item_action",
          "equipment_slot": "chest",
          "action": {
            "type": "origins:if_else",
            "condition": {
              "type": "origins:armor_value",
              "comparison": ">",
              "compare_to": 0
            },
            "if_action": {
              "type": "origins:consume"
            }
          }
        },
        {
          "type": "origins:equipped_item_action",
          "equipment_slot": "legs",
          "action": {
            "type": "origins:if_else",
            "condition": {
              "type": "origins:armor_value",
              "comparison": ">",
              "compare_to": 0
            },
            "if_action": {
              "type": "origins:consume"
            }
          }
        },
        {
          "type": "origins:equipped_item_action",
          "equipment_slot": "feet",
          "action": {
            "type": "origins:if_else",
            "condition": {
              "type": "origins:armor_value",
              "comparison": ">",
              "compare_to": 0
            },
            "if_action": {
              "type": "origins:consume"
            }
          }
        },
        {
          "type": "origins:area_of_effect",
          "radius": 8,
          "include_target": true,
          "bientity_action": {
            "type": "origins:target_action",
            "action": {
              "type": "origins:apply_effect",
              "effect": {
                "effect": "minecraft:resistance",
                "amplifier": 0,
                "duration": 600
              }
            }
          },
          "bientity_condition": {
            "type": "origins:target_condition",
            "condition": {
              "type": "origins:entity_type",
              "entity_type": "minecraft:player"
            }
          }
        }
      ]
    }
  }
}

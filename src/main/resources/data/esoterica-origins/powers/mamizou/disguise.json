{
  "name": "Perfect Actor",
  "description": "After 30 minutes as Bake-danuki, activate to open the origin selection GUI, allowing you to switch to any other origin for 30 minutes, after which you return to Bake-danuki form.",
  "type": "origins:multiple",
  "seconds": {
    "type": "origins:resource",
    "start_value": 0,
    "min": 0,
    "max": 1800,
    "hud_render": {
      "should_render": true,
      "sprite_location": "origins:textures/gui/community/huang/resource_bar_02.png",
      "bar_index": 1
    }
  },
  "increment": {
    "type": "origins:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_seconds",
      "change": 1
    }
  },
  "active": {
    "type": "origins:active_self",
    "condition": {
      "type": "origins:resource",
      "resource": "*:*_seconds",
      "comparison": "==",
      "compare_to": 1800
    },
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:execute_command",
          "command": "origin gui @s origins:origin"
        },
        {
          "type": "origins:grant_power",
          "power": "esoterica-origins:mamizou/disguise_return",
          "source": "esoterica-origins:mamizou/disguise"
        }
      ]
    },
    "key": {
      "key": "key.origins.secondary_active"
    }
  }
}

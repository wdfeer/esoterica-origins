{
  "hidden": true,
  "type": "origins:multiple",
  "seconds_left": {
    "type": "origins:resource",
    "start_value": 1800,
    "min": 0,
    "max": 1800,
    "hud_render": {
      "should_render": true,
      "sprite_location": "origins:textures/gui/community/huang/resource_bar_02.png",
      "bar_index": 1
    }
  },
  "decrement": {
    "type": "origins:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_seconds_left"
    }
  },
  "turn_back": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:revoke_power",
          "power": "esoterica-origins:mamizou/disguise_return",
          "source": "esoterica-origins:mamizou/disguise"
        },
        {
          "type": "origins:execute_command",
          "command": "origin set @s origins:origin esoterica-origins:mamizou"
        }
      ]
    },
    "interval": 21,
    "condition": {
      "type": "origins:resource",
      "resource": "*:*_seconds_left",
      "comparison": "==",
      "compare_to": 0
    }
  }
}
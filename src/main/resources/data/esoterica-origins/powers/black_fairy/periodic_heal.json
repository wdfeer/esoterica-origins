{
  "name": "Nature Spirit",
  "description": "Instead of natural health regeneration, you are restored to full health every 10 seconds.",
  "type": "origins:multiple",
  "disable_natural_regen": {
    "type": "origins:disable_regen"
  },
  "cooldown": {
    "type": "origins:cooldown",
    "cooldown": 200,
    "hud_render": {
      "should_render": true,
      "sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_02.png",
      "bar_index": 9
    }
  },
  "periodic_heal": {
    "type": "origins:action_over_time",
    "interval": 2,
    "condition": {
      "type": "origins:resource",
      "resource": "*:*_cooldown",
      "comparison": "==",
      "compare_to": 0
    },
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:heal",
          "amount": 99
        },
        {
          "type": "origins:trigger_cooldown",
          "power": "*:*_cooldown"
        }
      ]
    }
  }
}
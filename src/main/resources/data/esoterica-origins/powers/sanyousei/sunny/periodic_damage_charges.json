{
  "name": "Sunshine Needle",
  "description": "Gain 1 charge every 10 seconds, storing up to 7 charges. A charge is used to deal 3 additional damage and briefly set the victim on fire upon a melee or ranged attack.",
  "type": "origins:multiple",
  "charges": {
    "type": "origins:resource",
    "min": 0,
    "max": 7,
    "hud_render": {
      "should_render": true,
      "sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_points_01.png",
      "bar_index": 6
    }
  },
  "recharge": {
    "type": "origins:action_over_time",
    "interval": 200,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_charges",
      "change": 1
    }
  },
  "melee": {
    "type": "origins:modify_damage_dealt",
    "condition": {
      "type": "origins:resource",
      "resource": "*:*_charges",
      "comparison": ">",
      "compare_to": 0
    },
    "modifier": {
      "operation": "addition",
      "value": 3.0
    },
    "self_action": {
      "type": "origins:change_resource",
      "resource": "*:*_charges",
      "change": -1
    },
    "target_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:damage",
          "amount": 3,
          "damage_type": "minecraft:player_attack"
        },
        {
          "type": "origins:set_on_fire",
          "duration": 3
        }
      ]
    }
  },
  "ranged": {
    "type": "origins:modify_projectile_damage",
    "condition": {
      "type": "origins:resource",
      "resource": "*:*_charges",
      "comparison": ">",
      "compare_to": 0
    },
    "modifier": {
      "operation": "addition",
      "value": 3.0
    },
    "self_action": {
      "type": "origins:change_resource",
      "resource": "*:*_charges",
      "change": -1
    },
    "target_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:damage",
          "amount": 3,
          "damage_type": "minecraft:player_attack"
        },
        {
          "type": "origins:set_on_fire",
          "duration": 3
        }
      ]
    }
  }
}

{
  "name": "Berserk Lifeforce",
  "description": "Every 90 seconds, activate to apply Strength and Regeneration for 30 seconds to entities within 32 blocks in line of sight, including yourself. Sneaking players gain Speed and Resistance instead.",
  "type": "origins:active_self",
  "entity_action": {
    "type": "origins:area_of_effect",
    "radius": 32,
    "include_target": true,
    "bientity_action": {
      "type": "origins:target_action",
      "action": {
        "type": "origins:and",
        "actions": [
          {
            "type": "origins:if_else",
            "condition": {
              "type": "origins:sneaking"
            },
            "if_action": {
              "type": "origins:apply_effect",
              "effects": [
                {
                  "effect": "minecraft:strength",
                  "duration": 600,
                  "amplifier": 0
                },
                {
                  "effect": "minecraft:regeneration",
                  "duration": 600,
                  "amplifier": 0
                }
              ]
            },
            "else_action": {
              "type": "origins:apply_effect",
              "effects": [
                {
                  "effect": "minecraft:speed",
                  "duration": 600,
                  "amplifier": 0
                },
                {
                  "effect": "minecraft:resistance",
                  "duration": 600,
                  "amplifier": 0
                }
              ]
            }
          },
          {
            "type": "origins:spawn_particles",
            "particle": {
              "type": "minecraft:dust",
              "params": "0.9 0.1 0.7 2"
            },
            "count": 4,
            "speed": 0.2,
            "force": false,
            "spread": {
              "x": 1.0,
              "y": 1.5,
              "z": 1.0
            }
          },
          {
            "type": "origins:spawn_particles",
            "particle": {
              "type": "minecraft:end_rod"
            },
            "count": 7,
            "speed": 0.2,
            "force": false,
            "spread": {
              "x": 1.0,
              "y": 1.5,
              "z": 1.0
            }
          }
        ]
      }
    }
  },
  "cooldown": 2400,
  "hud_render": {
    "should_render": true,
    "sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_02.png",
    "bar_index": 1
  }
}